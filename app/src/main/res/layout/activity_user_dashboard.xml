<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dublin 8 Community"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/eventsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Browse Events" />

    <Button
        android:id="@+id/servicesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Community Services" />

    <Button
        android:id="@+id/subscriptionsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Subscriptions" />

    <Button
        android:id="@+id/surveysButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Surveys" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="32dp" />

</LinearLayout>