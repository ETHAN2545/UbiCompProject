<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Community Events"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/searchEventsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search events by name"
        android:inputType="text"
        android:padding="12dp" />

    <Spinner
        android:id="@+id/categoryFilterSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/locationFilterInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter by location"
        android:inputType="text"
        android:padding="12dp" />

    <Button
        android:id="@+id/resetFiltersButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Filters"
        android:layout_marginTop="8dp" />

    <ListView
        android:id="@+id/eventsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

</LinearLayout>
